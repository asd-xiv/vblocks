#!/usr/bin/env node

// NAME
//   get-skill-index-lines - Print a skill with the lines of its index recomputed
//
// SYNOPSIS
//   get-skill-index-lines <skill-file> [--write]
//
// DESCRIPTION
//   Recomputes each `L:<start>-<end>` and line count in the `## Index` of
//   <skill-file>, from the docs it lists. Paths are relative to the nearest
//   folder with a `package.json`, or to the folder group above them.
//
// OPTIONS
//   --write   Write the result back to <skill-file>
//
// EXIT CODES
//   0   Done
//   2   Invalid usage
//   3   A file or a heading of the index is missing

import { existsSync, readFileSync, writeFileSync } from "node:fs"
import { dirname, join, resolve } from "node:path"

const fail = (code, message) => {
  process.stderr.write(`get-skill-index-lines: ${message}\n`)
  process.exit(code)
}

/** Count the lines of a text, as `wc -l` does */
const countLines = text => text.split("\n").length - 1

/**
 * Find the 1-based lines of the section under a heading, up to the next heading
 * of the same or a higher level, without its trailing blank lines. Skip code
 * fences
 */
const findSectionLines = (text, heading) => {
  const lines = text.split("\n")
  const level = heading.indexOf(" ")
  let isInFence = false
  let start
  let next = lines.length

  for (const [index, line] of lines.entries()) {
    if (line.startsWith("```")) isInFence = !isInFence
    if (isInFence) continue

    if (start === undefined) {
      if (line === heading) start = index
    } else if (/^#{1,6} /.test(line) && line.indexOf(" ") <= level) {
      next = index
      break
    }
  }

  if (start === undefined) return undefined

  let end = next - 1
  while (end > start && lines[end].trim() === "") end--

  return { start: start + 1, end: end + 1 }
}

/**
 * The kinds of index line. Each recomputes its numbers, and sets the folder or
 * the file the lines under it refer to
 */
const LINE_KINDS = [
  {
    // **`README.md`**, 488 lines:   or   **`template/`**:
    match: /^\*\*`(?<path>[^`]+)`\*\*(, \d+ lines)?:$/,
    apply: ({ path }) =>
      path.endsWith("/")
        ? { line: `**\`${path}\`**:`, folder: path, file: undefined }
        : {
            line: `**\`${path}\`**, ${countLines(readDoc(path))} lines:`,
            folder: "",
            file: path,
          },
  },
  {
    // - **`_common/README.md`**, 51 lines:   or   - `client.d.ts`, 137 lines
    match:
      /^(?<indent>\s*)- (?<bold>\*\*)?`(?<path>[^`]+)`\k<bold>, \d+ lines(?<colon>:?)$/,
    apply: ({ indent, bold = "", path, colon }, { folder }) => {
      const file = join(folder, path)
      const count = countLines(readDoc(file))

      return {
        line: `${indent}- ${bold}\`${path}\`${bold}, ${count} lines${colon}`,
        file,
      }
    },
  },
  {
    // - "### Use CSS Modules" L:210-235
    match: /^(?<indent>\s*)- "(?<heading>.+)" L:\d+-\d+$/,
    apply: ({ indent, heading }, { file }) => {
      const lines = file && findSectionLines(readDoc(file), heading)

      if (!lines) throw new Error(`No heading "${heading}" in ${file}`)

      return { line: `${indent}- "${heading}" L:${lines.start}-${lines.end}` }
    },
  },
]

/** Recompute the numbers in the `## Index` of a skill */
const formatSkillIndex = skill => {
  let isInIndex = false
  let context = { folder: "", file: undefined }

  return skill
    .split("\n")
    .map(line => {
      if (line.startsWith("## ")) isInIndex = line === "## Index"

      const kind = isInIndex && LINE_KINDS.find(({ match }) => match.test(line))

      if (!kind) return line

      const { line: nextLine, ...nextContext } = kind.apply(
        line.match(kind.match).groups,
        context
      )
      context = { ...context, ...nextContext }

      return nextLine
    })
    .join("\n")
}

// ╭───
// │ Main
// ╰───

const shouldWrite = process.argv.includes("--write")
const [skillFile, ...rest] = process.argv
  .slice(2)
  .filter(arg => arg !== "--write")

if (skillFile === undefined || rest.length > 0 || !existsSync(skillFile)) {
  fail(2, "Usage: get-skill-index-lines <skill-file> [--write]")
}

let packageRoot = dirname(resolve(skillFile))

while (!existsSync(join(packageRoot, "package.json"))) {
  if (packageRoot === dirname(packageRoot)) {
    fail(3, `No package.json above ${skillFile}`)
  }
  packageRoot = dirname(packageRoot)
}

const readDoc = path => {
  const file = join(packageRoot, path)

  if (!existsSync(file)) throw new Error(`No file ${path}`)

  return readFileSync(file, "utf8")
}

let result = ""

try {
  result = formatSkillIndex(readFileSync(skillFile, "utf8"))
} catch (error) {
  fail(3, error.message)
}

if (shouldWrite) {
  writeFileSync(skillFile, result)
} else {
  process.stdout.write(result)
}
