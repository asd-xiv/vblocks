#!/bin/sh

set -eu

# NAME
#   verify-templates - Typecheck and build every template `vblocks init` writes
#
# SYNOPSIS
#   verify-templates [OPTIONS]
#
# DESCRIPTION
#   For each template in `template/`, runs `vblocks init` into
#   `tmp/verify-templates/<name>`, then `tsc`, `vblocks build` and
#   `vblocks build --single-file` there. A template is a folder whose name has
#   no `_` prefix.
#
#   Then runs `vblocks init --only plumbing` into
#   `tmp/verify-templates/<name>_only-app`, adds the template there as the app
#   `demo` with `--only app`, and builds it with `--prefix`.
#
#   SWC strips the types without checking them. Only `tsc` finds a type error.
#   The app has the same `src/` and `tsconfig.json`, so it skips `tsc`.
#
#   Installs nothing. Each project resolves its dependencies from the
#   `node_modules` of this repo, so a dependency of a template must also be a
#   `devDependencies` entry here.
#
# OPTIONS
#   -h, --help    Print this help
#
# EXAMPLE
#   tools/verify-templates
#
# EXIT CODES
#   0   Every template typechecked and built
#   2   Invalid usage
#   3   A template or an app did not scaffold, typecheck or build
#
# SEE ALSO
#   bin/vblocks

VBLOCKS_PKG_ROOT_DIR=$(dirname "$(dirname "$(realpath "$0")")")
VBLOCKS_CMD="$VBLOCKS_PKG_ROOT_DIR/bin/vblocks"
# Use the `tsc` of this repo, as with the dependencies of the templates
TSC_CMD=$(node -p \
  'require.resolve("typescript/bin/tsc", { paths: [process.argv[1]] })' \
  "$VBLOCKS_PKG_ROOT_DIR")
TEMP_DIR="$VBLOCKS_PKG_ROOT_DIR/tmp/verify-templates"

# ╭───
# │ Primitives
# ╰───

# build_template <name>
#
# Scaffold, typecheck and build a template
build_template() {
  bt_root_dir="$TEMP_DIR/$1"

  rm -rf -- "$bt_root_dir"
  "$VBLOCKS_CMD" init "$bt_root_dir" --template "$1"

  # wrap in subshell to revert `cd`
  (
    cd -- "$bt_root_dir"
    node "$TSC_CMD" --project .
    "$VBLOCKS_CMD" build
    "$VBLOCKS_CMD" build --single-file
  )
}

# build_app <name>
#
# Scaffold the plumbing, add the template <name> as the app `demo`, then build
# it with `--prefix`
build_app() {
  ba_root_dir="$TEMP_DIR/$1_only-app"
  ba_app_name="demo"
  ba_app_dir="$ba_root_dir/$ba_app_name"

  rm -rf -- "$ba_root_dir"
  "$VBLOCKS_CMD" init "$ba_root_dir" --only plumbing
  "$VBLOCKS_CMD" init "$ba_app_dir" --template "$1" --only app

  # wrap in subshell to revert `cd`
  (
    cd -- "$ba_root_dir"
    "$VBLOCKS_CMD" build --prefix "$ba_app_name" --single-file
  )
}

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    sed -n '/^# NAME$/,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  "") ;;
  *)
    printf 'Usage: verify-templates [-h | --help]\n' >&2
    exit 2
    ;;
esac

# ╭───
# │ Main
# ╰───

CURRENT_STEP=""

# report_failure
#
# On a failed exit, name CURRENT_STEP and exit 3, as EXIT CODES promises.
# shellcheck disable=SC2329 # trap calls it
report_failure() {
  rf_status=$?
  [ "$rf_status" -eq 0 ] && return 0

  printf '%s did not scaffold, typecheck or build\n' "$CURRENT_STEP" >&2
  exit 3
}

trap report_failure EXIT

for TEMPLATE_DIR in "$VBLOCKS_PKG_ROOT_DIR"/template/*/; do
  [ -d "$TEMPLATE_DIR" ] || continue
  TEMPLATE_NAME=$(basename "$TEMPLATE_DIR")

  case "$TEMPLATE_NAME" in
    _*) continue ;;
  esac

  CURRENT_STEP="Template \"$TEMPLATE_NAME\""
  build_template "$TEMPLATE_NAME"

  CURRENT_STEP="The app of template \"$TEMPLATE_NAME\""
  build_app "$TEMPLATE_NAME"
done

exit 0
