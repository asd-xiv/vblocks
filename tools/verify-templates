#!/bin/sh

set -eu

# NAME
#   verify-templates - Build every template `vblocks init` writes
#
# SYNOPSIS
#   verify-templates [OPTIONS]
#
# DESCRIPTION
#   For each template in `template/`, runs `vblocks init` into `tmp/<name>`,
#   then `vblocks build` and `vblocks build --single-file` there. A template is
#   a folder whose name has no `_` prefix.
#
#   Then runs `vblocks init --only plumbing` into `tmp/_apps`, adds one app per
#   template with `--only app`, and builds each from `tmp/_apps` with
#   `--prefix`.
#
#   Installs nothing. Each project resolves its dependencies from the
#   `node_modules` of this repo, so a dependency of a template must also be a
#   `devDependencies` entry here.
#
# OPTIONS
#   -h, --help    Print this help
#
# EXAMPLE
#   tools/verify-templates
#
# EXIT CODES
#   0   Every template built
#   2   Invalid usage
#   3   A template or an app did not scaffold or build
#
# SEE ALSO
#   bin/vblocks

ROOT_DIR=$(dirname "$(dirname "$(realpath "$0")")")
VBLOCKS_SCRIPT="$ROOT_DIR/bin/vblocks"
OUT_DIR="$ROOT_DIR/tmp"

# ╭───
# │ Primitives
# ╰───

# build_template <name>
#
# Scaffold the template <name> into `tmp/<name>` and build it both ways.
build_template() {
  build_dir="$OUT_DIR/$1"

  rm -rf -- "$build_dir"
  "$VBLOCKS_SCRIPT" init "$build_dir" --template "$1"

  (
    cd -- "$build_dir"
    "$VBLOCKS_SCRIPT" build
    "$VBLOCKS_SCRIPT" build --single-file
  )
}

# build_apps <name>...
#
# Scaffold the plumbing into `tmp/_apps` and one app per template <name> inside
# it, then build each app from `tmp/_apps`.
build_apps() {
  apps_dir="$OUT_DIR/_apps"

  rm -rf -- "$apps_dir"
  "$VBLOCKS_SCRIPT" init "$apps_dir" --only plumbing || return 1

  for apps_template in "$@"; do
    "$VBLOCKS_SCRIPT" init "$apps_dir/$apps_template" \
      --template "$apps_template" --only app || return 1
  done

  (
    cd -- "$apps_dir" || exit 1
    for apps_template in "$@"; do
      "$VBLOCKS_SCRIPT" build --prefix "$apps_template" --single-file || exit 1
    done
  )
}

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    sed -n '/^# NAME$/,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  "") ;;
  *)
    printf 'Usage: verify-templates [-h | --help]\n' >&2
    exit 2
    ;;
esac

# ╭───
# │ Main
# ╰───

TEMPLATES=""
for TEMPLATE_DIR in "$ROOT_DIR"/template/*/; do
  [ -d "$TEMPLATE_DIR" ] || continue
  TEMPLATE=$(basename "$TEMPLATE_DIR")

  case "$TEMPLATE" in
    _*) continue ;;
  esac

  if ! build_template "$TEMPLATE"; then
    printf 'Template "%s" did not scaffold or build\n' "$TEMPLATE" >&2
    exit 3
  fi

  TEMPLATES="$TEMPLATES $TEMPLATE"
done

# shellcheck disable=SC2086 # one template name per word
if ! build_apps $TEMPLATES; then
  printf 'The apps of "%s" did not scaffold or build\n' "$OUT_DIR/_apps" >&2
  exit 3
fi

exit 0
