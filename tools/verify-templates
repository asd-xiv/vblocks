#!/bin/sh

set -eu

# NAME
#   verify-templates - Typecheck, build and serve every template `vblocks init`
#   writes
#
# SYNOPSIS
#   verify-templates [OPTIONS]
#
# DESCRIPTION
#   For each template in `template/`, runs `vblocks init` into
#   `tmp/verify-templates/<name>`, then `tsc`, `vblocks build` and
#   `vblocks build --single-file` there. A template is a folder whose name has
#   no `_` prefix.
#
#   Then runs `vblocks serve` there, waits until Webpack compiles and the
#   server starts, and requests the page. It fails after 60 seconds.
#
#   Then runs `vblocks init --only plumbing` into
#   `tmp/verify-templates/<name>_only-app`, adds the template there as the app
#   `demo` with `--only app`, and builds it with `--prefix`.
#
#   SWC strips the types without checking them. Only `tsc` finds a type error.
#   The app has the same `src/` and `tsconfig.json`, so it skips `tsc`.
#
#   Installs nothing. Each project resolves its dependencies from the
#   `node_modules` of this repo, so a dependency of a template must also be a
#   `devDependencies` entry here.
#
# OPTIONS
#   -h, --help    Print this help
#
# EXAMPLE
#   tools/verify-templates
#
# EXIT CODES
#   0   Every template typechecked, built and served
#   2   Invalid usage
#   3   A template or an app did not scaffold, typecheck, build or serve
#
# SEE ALSO
#   bin/vblocks

VBLOCKS_PKG_ROOT_DIR=$(dirname "$(dirname "$(realpath "$0")")")
VBLOCKS_CMD="$VBLOCKS_PKG_ROOT_DIR/bin/vblocks"
# Use the `tsc` of this repo, as with the dependencies of the templates
TSC_CMD=$(node -p \
  'require.resolve("typescript/bin/tsc", { paths: [process.argv[1]] })' \
  "$VBLOCKS_PKG_ROOT_DIR")
TEMP_DIR="$VBLOCKS_PKG_ROOT_DIR/tmp/verify-templates"
SERVER_PID="" # the server serve_template runs, for stop_server

# ╭───
# │ Primitives
# ╰───

# build_template <name>
#
# Scaffold, typecheck and build a template
build_template() {
  bt_root_dir="$TEMP_DIR/$1"

  rm -rf -- "$bt_root_dir"
  "$VBLOCKS_CMD" init "$bt_root_dir" --template "$1"

  # wrap in subshell to revert `cd`
  (
    cd -- "$bt_root_dir"
    node "$TSC_CMD" --project .
    "$VBLOCKS_CMD" build
    "$VBLOCKS_CMD" build --single-file
  )
}

# stop_process_tree <pid>
#
# Send TERM to <pid> and to each process it started. The serve script runs
# Webpack as a child, which outlives a TERM to the script alone
stop_process_tree() {
  for spt_child_pid in $(ps -A -o pid= -o ppid= | awk -v ppid="$1" '$2 == ppid { print $1 }'); do
    stop_process_tree "$spt_child_pid"
  done

  kill -- "$1" 2>/dev/null || true
}

# stop_server
#
# Stop the server serve_template runs, if any
stop_server() {
  if [ -n "$SERVER_PID" ]; then
    stop_process_tree "$SERVER_PID"
    wait "$SERVER_PID" 2>/dev/null || true
    SERVER_PID=""
  fi
}

# serve_template <name>
#
# Serve the scaffold of template <name>. Wait until Webpack compiles it and the
# server starts, then request the page
#
# RETURNS
#   1   Webpack failed, the server did not start in 60 seconds, or the page did
#       not answer
serve_template() {
  st_log_file="$TEMP_DIR/$1.serve.log"

  # NO_COLOR keeps the log plain for grep. --no-open keeps the browser closed
  (cd -- "$TEMP_DIR/$1" && NO_COLOR=1 exec "$VBLOCKS_CMD" serve -- --no-open) \
    > "$st_log_file" 2>&1 &
  SERVER_PID=$!

  # Webpack and the server each print one line, in either order
  st_seconds=0
  until grep -q "webpack compiled" "$st_log_file" &&
    grep -q "Started the server" "$st_log_file"; do
    if [ "$st_seconds" -ge 60 ] || ! kill -0 "$SERVER_PID" 2>/dev/null; then
      cat -- "$st_log_file" >&2
      return 1
    fi

    sleep 1
    st_seconds=$((st_seconds + 1))
  done

  if ! grep -q "webpack compiled successfully" "$st_log_file"; then
    cat -- "$st_log_file" >&2
    return 1
  fi

  st_url=$(sed -n 's/.*url=\(http:[^ ]*\).*/\1/p' "$st_log_file")
  node -e '
    fetch(process.argv[1]).then(
      response => process.exit(response.ok ? 0 : 1),
      () => process.exit(1)
    )' "$st_url"

  stop_server
}

# build_app <name>
#
# Scaffold the plumbing, add the template <name> as the app `demo`, then build
# it with `--prefix`
build_app() {
  ba_root_dir="$TEMP_DIR/$1_only-app"
  ba_app_name="demo"
  ba_app_dir="$ba_root_dir/$ba_app_name"

  rm -rf -- "$ba_root_dir"
  "$VBLOCKS_CMD" init "$ba_root_dir" --only plumbing
  "$VBLOCKS_CMD" init "$ba_app_dir" --template "$1" --only app

  # wrap in subshell to revert `cd`
  (
    cd -- "$ba_root_dir"
    "$VBLOCKS_CMD" build --prefix "$ba_app_name" --single-file
  )
}

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    sed -n '/^# NAME$/,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  "") ;;
  *)
    printf 'Usage: verify-templates [-h | --help]\n' >&2
    exit 2
    ;;
esac


# ╭───
# │ Main
# ╰───

# A scaffold depends on @asd14/vblocks, which the node_modules of this repo
# cannot contain. Link it, as an install of the scaffold would
rm -rf -- "$TEMP_DIR"
mkdir -p -- "$TEMP_DIR/node_modules/@asd14"
ln -s -- "$VBLOCKS_PKG_ROOT_DIR" "$TEMP_DIR/node_modules/@asd14/vblocks"

CURRENT_STEP=""

# finish_run [<signal>]
#
# Stop the server, which ignores INT and would outlive the script. Then end with
# <signal>, or on a failed exit, name CURRENT_STEP and exit 3, as EXIT CODES
# promises
# shellcheck disable=SC2329 # trap calls it
finish_run() {
  fr_status=$?
  trap - EXIT INT TERM
  stop_server

  if [ -n "${1:-}" ]; then
    kill -s "$1" "$$"
  fi

  if [ "$fr_status" -ne 0 ]; then
    printf '%s did not scaffold, typecheck, build or serve\n' "$CURRENT_STEP" >&2
    exit 3
  fi
}

trap finish_run EXIT
trap 'finish_run INT' INT
trap 'finish_run TERM' TERM

for TEMPLATE_DIR in "$VBLOCKS_PKG_ROOT_DIR"/template/*/; do
  [ -d "$TEMPLATE_DIR" ] || continue
  TEMPLATE_NAME=$(basename "$TEMPLATE_DIR")

  case "$TEMPLATE_NAME" in
    _*) continue ;;
  esac
  CURRENT_STEP="Template \"$TEMPLATE_NAME\""
  build_template "$TEMPLATE_NAME"
  serve_template "$TEMPLATE_NAME"

  CURRENT_STEP="The app of template \"$TEMPLATE_NAME\""
  build_app "$TEMPLATE_NAME"
done

exit 0
