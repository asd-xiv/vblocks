{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@asd14/ts-config/targets/react.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["@asd14/vblocks/client"],
    "paths": {
      "@self/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
