{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@asd14/vblocks",
  "version": "4.0.0",
  "description": "Zero-config React builds, as a static site or a single HTML file",
  "keywords": [
    "react",
    "webpack",
    "zero-config",
    "single-file",
    "static-site",
    "spa",
    "scaffolding",
    "cli",
    "ai-agents",
    "swc",
    "postcss",
    "mdx"
  ],
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "type:lib",
      "target:react"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asd-xiv/vblocks.git"
  },
  "files": [
    "bin",
    "src",
    "template"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/types/client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vblocks": "bin/vblocks.sh"
  },
  "scripts": {
    "----UTIL": "",
    "prepare": "git config --local core.hooksPath .githook",
    "format": "eslint --fix .",
    "----CODE-QA": "",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "unit-test:template": "tools/verify-templates",
    "unit-test": "npm run unit-test:template"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@swc/helpers": "^0.5.23",
    "browserslist": "^4.29.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "cssnano": "^9.6.0",
    "dotenv-webpack": "^9.0.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.1",
    "react-refresh": "^0.19.0",
    "swc-loader": "^0.2.7",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "devDependencies": {
    "@asd14/eslint-config": "^15.4.0",
    "@asd14/prettier-config": "^1.5.0",
    "@asd14/semantic-release-config": "^1.0.1",
    "@asd14/ts-config": "^1.6.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dotenv-webpack": "^7.0.8",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@xyflow/react": "^12.12.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0"
  }
}
