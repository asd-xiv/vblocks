#!/bin/sh

set -eu

# NAME
#   vblocks - Zero-config React builds, as a static site or a single HTML file
#
# SYNOPSIS
#   vblocks <command> [OPTIONS]
#   vblocks -h | --help
#
# DESCRIPTION
#   Each command prints its own help with --help.
#
# ARGUMENTS
#   command   init    Write a template into a folder
#             serve   Start the development server of an app
#             build   Build an app into dist/ in its folder
#             eject   Print a default config of VBlocks
#
# OPTIONS
#   -h, --help   Print this help
#
# EXAMPLE
#   npx @asd14/vblocks init my-app
#   npx vblocks serve --help
#
# EXIT CODES
#   0   Done
#   2   No command, or an unknown command
#
#   A command exits with the codes its help lists.
#
# SEE ALSO
#   vblocks init, vblocks serve, vblocks build, vblocks eject

# npm links the command to this file, so "$0" names the link. realpath follows
# it to the package, where vblocks.d/ holds the commands
_SCRIPT_DIR="$(dirname "$(realpath "$0")")/vblocks.d"
# shellcheck source=vblocks.d/vblocks.sh
. "$_SCRIPT_DIR/vblocks.sh"

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0" >&2
    exit 2
    ;;
esac

# ╭───
# │ Main
# ╰───

_COMMAND=$1
shift

case "$_COMMAND" in
  init | serve | build | eject) ;;
  *) _fail 2 -v command "$_COMMAND" -v available_commands "init,serve,build,eject" "Unknown command" ;;
esac

# sh runs the command file, whatever mode npm gave it
exec sh "$_SCRIPT_DIR/$_COMMAND" "$@"
