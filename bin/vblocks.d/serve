#!/bin/sh

# vblocks serve [OPTIONS] [<webpack option>...]
#
# Start the development server. vblocks runs this file. Never call it directly.

set -eu

_SCRIPT_DIR=$(dirname "$0")
# shellcheck source=vblocks.sh
. "$_SCRIPT_DIR/vblocks.sh"
# shellcheck source=webpack.sh
. "$_SCRIPT_DIR/webpack.sh"

# ╭───
# │ Settings
# ╰───

_PREFIX_DIR=""    # --prefix, the app folder
_LOG_LEVEL="warn" # --log-level: error, warn, info or verbose

# ╭───
# │ Flags and positionals
# ╰───

# Take the flags of VBlocks out of the arguments. Webpack gets the rest
_ARG_COUNT=$#
while [ "$_ARG_COUNT" -gt 0 ]; do
  _ARG=$1
  shift
  _ARG_COUNT=$((_ARG_COUNT - 1))

  case "$_ARG" in
    --prefix)
      [ "$_ARG_COUNT" -eq 0 ] && _fail 2 "--prefix needs a folder"
      _PREFIX_DIR=$1
      shift
      _ARG_COUNT=$((_ARG_COUNT - 1))
      ;;
    --log-level)
      [ "$_ARG_COUNT" -eq 0 ] && _guard_log_level ""
      _guard_log_level "$1"
      _LOG_LEVEL=$1
      shift
      _ARG_COUNT=$((_ARG_COUNT - 1))
      ;;
    --analyze)
      # The default Webpack config reads env.analyze. An ejected config
      # supports the flag only if it reads env.analyze too
      set -- "$@" --env analyze
      ;;
    --single-file)
      _fail 2 "--single-file works only with build"
      ;;
    *)
      set -- "$@" "$_ARG"
      ;;
  esac
done

if [ -n "$_PREFIX_DIR" ] && [ ! -d "$_PREFIX_DIR" ]; then
  _fail 2 -v prefix "$_PREFIX_DIR" "--prefix is not a folder"
fi

# node runs webpack-cli
_require_cmd node
_export_package_info

# ╭───
# │ Main
# ╰───

_APP_DIR=$(cd -- "${_PREFIX_DIR:-.}" && pwd)
_WEBPACK_CONFIG=$(_pick_config "$_APP_DIR" webpack.config.js)
_export_configs "$_APP_DIR"

_print_header "$VB_VERSION" "$VB_DESCRIPTION" >&2
_print_summary "$_APP_DIR" "$_WEBPACK_CONFIG" "$VB_POSTCSS_CONFIG" "$VB_SWC_CONFIG"

# Without a mode, Webpack takes `production`, also for `serve`. A --mode in
# "$@" comes later, so it overrides this one
_run_webpack serve "$_APP_DIR" "$_WEBPACK_CONFIG" "$_LOG_LEVEL" --mode development "$@"
exit 0
