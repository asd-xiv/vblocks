#!/bin/sh

# vblocks serve [OPTIONS] [-- <webpack option>...]
#
# Start the development server. vblocks runs this file. Never call it directly.

set -eu

_SCRIPT_DIR=$(dirname "$0")
# shellcheck source=vblocks.sh
. "$_SCRIPT_DIR/vblocks.sh"
# shellcheck source=webpack.sh
. "$_SCRIPT_DIR/webpack.sh"

# ╭───
# │ Settings
# ╰───

_PREFIX_DIR=""      # --prefix, the app folder
_MODE="development" # --mode: development or production
_LOG_LEVEL="warn"   # --log-level: error, warn, info or verbose
_SHOULD_ANALYZE=""  # --analyze, "true" or ""

# ╭───
# │ Flags and positionals
# ╰───

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prefix)
      [ "$#" -lt 2 ] && _fail 2 "--prefix needs a folder"
      _PREFIX_DIR=$2
      shift 2
      ;;
    --mode)
      _guard_mode "${2:-}"
      _MODE=$2
      shift 2
      ;;
    --log-level)
      _guard_log_level "${2:-}"
      _LOG_LEVEL=$2
      shift 2
      ;;
    --analyze)
      _SHOULD_ANALYZE="true"
      shift
      ;;
    --single-file)
      _fail 2 "--single-file works only with build"
      ;;
    --)
      shift
      break
      ;;
    -?*)
      _fail 2 -v flag "$1" "Unknown flag. For Webpack options, place them after --"
      ;;
    *)
      _fail 2 -v argument "$1" "serve takes no positional"
      ;;
  esac
done

if [ -n "$_PREFIX_DIR" ] && [ ! -d "$_PREFIX_DIR" ]; then
  _fail 2 -v prefix "$_PREFIX_DIR" "--prefix is not a folder"
fi

# node runs webpack-cli
_require_cmd node
_export_package_info

# ╭───
# │ Main
# ╰───

_APP_DIR=$(cd -- "${_PREFIX_DIR:-.}" && pwd)
_WEBPACK_CONFIG=$(_pick_config "$_APP_DIR" webpack.config.js)
_POSTCSS_CONFIG=$(_pick_config "$_APP_DIR" postcss.config.js)
_SWC_CONFIG=$(_pick_config "$_APP_DIR" .swcrc)

_print_header "$VB_VERSION" "$VB_DESCRIPTION" >&2
_print_summary "$_APP_DIR" "$_WEBPACK_CONFIG" "$_POSTCSS_CONFIG" "$_SWC_CONFIG"

# The default Webpack config reads env.analyze. An ejected config supports
# --analyze only if it reads env.analyze too
_run_webpack serve "$_APP_DIR" "$_WEBPACK_CONFIG" "$_POSTCSS_CONFIG" "$_SWC_CONFIG" "$_LOG_LEVEL" \
  --mode "$_MODE" ${_SHOULD_ANALYZE:+--env analyze} "$@"
exit 0
