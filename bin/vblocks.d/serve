#!/bin/sh

# NAME
#   vblocks serve - Start the development server of an app
#
# SYNOPSIS
#   vblocks serve
#     [--mode <development|production>]
#     [--prefix <folder>]
#     [--analyze]
#     [--log-level <error|warn|info|verbose>]
#     [-- <webpack option>...]
#
# DESCRIPTION
#   The app folder contains src/index.tsx and src/index.html. A config in it,
#   webpack.config.js, postcss.config.js, .swcrc or .browserslistrc, replaces
#   the VBlocks default of the same name. So do src/public/robots.txt and
#   src/public/favicon.svg.
#
#   Print the app folder, the VBlocks folder, the files Webpack runs with and
#   the source of the browsers, then start the server.
#
#   SWC, Webpack and postcss-preset-env compile for the browsers of the app's
#   browserslist config. browserslist reads BROWSERSLIST, BROWSERSLIST_CONFIG,
#   then a .browserslistrc or the browserslist field of package.json, from the
#   app folder up. Without any of them, browserslist reads the VBlocks default,
#   defaults/.browserslistrc.
#
#   The server runs at http://localhost:8080, or the next free port. It opens
#   the page in the browser. It listens on localhost, so another device cannot
#   open the page. Pass -- --host 0.0.0.0 to expose it to the network.
#
# OPTIONS
#   --mode <mode>              The Webpack mode, development or production
#                              (default: development)
#   --prefix <folder>          The app folder, which must exist (default: the
#                              current folder)
#   --analyze                  Run the bundle analyzer, on a free port. An
#                              ejected webpack.config.js runs the analyzer
#                              only if it reads env.analyze
#   --log-level <level>        How much Webpack and its development server
#                              print: error, warn, info or verbose (default:
#                              warn)
#   -- <webpack option>...     Pass each option to Webpack, unchanged
#   -h, --help                 Print this help
#
# ENVIRONMENT
#   NO_COLOR              When non-empty, print without color, the icons or
#                         the header
#   BROWSERSLIST          The browsers, as a browserslist query. It overrides
#                         every config file
#   BROWSERSLIST_CONFIG   The path of a browserslist config, in place of the
#                         one browserslist finds from the app folder up
#
# EXAMPLE
#   npx vblocks serve
#   npx vblocks serve --prefix flow -- --host 0.0.0.0
#
# EXIT CODES
#   0   Done
#   2   Invalid usage, Webpack rejected an option or the config, or
#       browserslist could not read a config
#   3   Could not run: a missing tool, or a failed Webpack run
#
# SEE ALSO
#   vblocks, vblocks build, vblocks eject, webpack

# vblocks runs this file. Never call it directly.

set -eu

_SCRIPT_DIR=$(dirname "$0")
# tools/update-lib downloads lib/ from posix-utils, never edit it here
# shellcheck source=lib/log.sh
. "$_SCRIPT_DIR/lib/log.sh"
# shellcheck source=lib/validation.sh
. "$_SCRIPT_DIR/lib/validation.sh"
# shellcheck source=lib/guard.sh
. "$_SCRIPT_DIR/lib/guard.sh"
# shellcheck source=lib/help.sh
. "$_SCRIPT_DIR/lib/help.sh"
# shellcheck source=vblocks.sh
. "$_SCRIPT_DIR/vblocks.sh"
# shellcheck source=webpack.sh
. "$_SCRIPT_DIR/webpack.sh"

# ╭───
# │ Settings
# ╰───

_PREFIX_DIR=""      # --prefix, the app folder
_MODE="development" # --mode: development or production
_LOG_LEVEL="warn"   # --log-level: error, warn, info or verbose
_SHOULD_ANALYZE=""  # --analyze, "true" or ""

# ╭───
# │ Flags and positionals
# ╰───

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      _show_help "$0"
      exit 0
      ;;
    --prefix)
      [ "$#" -lt 2 ] && _fail 2 "--prefix needs a folder"
      _PREFIX_DIR=$2
      shift 2
      ;;
    --mode)
      _guard_mode "${2:-}"
      _MODE=$2
      shift 2
      ;;
    --log-level)
      _guard_log_level "${2:-}"
      _LOG_LEVEL=$2
      shift 2
      ;;
    --analyze)
      _SHOULD_ANALYZE="true"
      shift
      ;;
    --single-file | --single)
      _fail 2 "--single-file works only with build"
      ;;
    --)
      shift
      break
      ;;
    -?*)
      _fail 2 -v flag "$1" "Unknown flag. For Webpack options, place them after --"
      ;;
    *)
      _fail 2 -v argument "$1" "serve takes no positional"
      ;;
  esac
done

if [ -n "$_PREFIX_DIR" ] && [ ! -d "$_PREFIX_DIR" ]; then
  _fail 2 -v prefix "$_PREFIX_DIR" "--prefix is not a folder"
fi

# node runs webpack-cli
_require_cmd node
_export_version

# ╭───
# │ Main
# ╰───

_APP_DIR=$(cd -- "${_PREFIX_DIR:-.}" && pwd)
_WEBPACK_CONFIG=$(_pick_file "$_APP_DIR" webpack.config.js)
_POSTCSS_CONFIG=$(_pick_file "$_APP_DIR" postcss.config.js)
_SWC_CONFIG=$(_pick_file "$_APP_DIR" .swcrc)
_ROBOTS_FILE=$(_pick_file "$_APP_DIR" src/public/robots.txt)
_FAVICON_FILE=$(_pick_file "$_APP_DIR" src/public/favicon.svg)
_pick_browserslist "$_APP_DIR"
_BROWSERSLIST_SOURCE=$(_find_browserslist "$_APP_DIR")

_print_header "$VB_VERSION" "${_BOLD}serve${_RESET}: $_MODE${_SHOULD_ANALYZE:+, analyze}" >&2
_print_summary "$_APP_DIR" "$_WEBPACK_CONFIG" "$_POSTCSS_CONFIG" "$_SWC_CONFIG" \
  "$_ROBOTS_FILE" "$_FAVICON_FILE" "$_BROWSERSLIST_SOURCE"

# The default Webpack config reads env.analyze. An ejected config supports
# --analyze only if it reads env.analyze too
_run_webpack serve "$_WEBPACK_CONFIG" \
  --env "entryDir=$_APP_DIR" \
  --env "postcssConfigPath=$_POSTCSS_CONFIG" \
  --env "swcConfigPath=$_SWC_CONFIG" \
  --env "robotsPath=$_ROBOTS_FILE" \
  --env "faviconPath=$_FAVICON_FILE" \
  --env "logLevel=$_LOG_LEVEL" \
  --mode "$_MODE" ${_SHOULD_ANALYZE:+--env analyze} "$@"
exit 0
