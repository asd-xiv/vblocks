#!/bin/sh

# vblocks build [OPTIONS] [-- <webpack option>...]
#
# Build the app into dist/ in the app folder, then print
# each file in it. vblocks runs this file. Never call it directly.

set -eu

_SCRIPT_DIR=$(dirname "$0")
# shellcheck source=vblocks.sh
. "$_SCRIPT_DIR/vblocks.sh"
# shellcheck source=webpack.sh
. "$_SCRIPT_DIR/webpack.sh"

# ╭───
# │ Settings
# ╰───

_PREFIX_DIR=""     # --prefix, the app folder
_MODE="production" # --mode: development or production
_LOG_LEVEL="warn"  # --log-level: error, warn, info or verbose
_IS_SINGLE_FILE="" # --single-file, "true" or ""

# ╭───
# │ Domain primitives
# ╰───

# _print_build_files <app-dir>
#
# Print each file in the dist/ of <app-dir> as $APP_DIR/dist/..., a tab and its
# size, then the total size. Webpack empties dist/ before each build, so every
# file there is from the last build.
_print_build_files() {
  # An ejected config can write elsewhere
  [ -d "$1/dist" ] || return 0

  (cd -- "$1/dist" && find . -type f | LC_ALL=C sort) \
    | while IFS= read -r pbf_file; do
      printf '%s\t%s\n' "$(wc -c <"$1/dist/$pbf_file")" "${pbf_file#./}"
    done \
    | awk -F '\t' -v gray="$_GRAY" -v bold="$_BOLD" -v reset="$_RESET" '
      function format_size(bytes) {
        if (bytes < 1024) return bytes " B"
        if (bytes < 1024 * 1024) return sprintf("%.1f KiB", bytes / 1024)
        return sprintf("%.1f MiB", bytes / 1024 / 1024)
      }

      {
        total += $1
        printf "$APP_DIR/dist/%s\t%s%s%s\n", $2, gray, format_size($1), reset
      }
      END { printf "\n%sTotal%s\t%s\n", bold, reset, format_size(total) }
    '
}

# ╭───
# │ Flags and positionals
# ╰───

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prefix)
      [ "$#" -lt 2 ] && _fail 2 "--prefix needs a folder"
      _PREFIX_DIR=$2
      shift 2
      ;;
    --mode)
      _guard_mode "${2:-}"
      _MODE=$2
      shift 2
      ;;
    --log-level)
      _guard_log_level "${2:-}"
      _LOG_LEVEL=$2
      shift 2
      ;;
    --single-file | --single)
      _IS_SINGLE_FILE="true"
      shift
      ;;
    --analyze)
      _fail 2 "--analyze works only with serve"
      ;;
    --)
      shift
      break
      ;;
    -?*)
      _fail 2 -v flag "$1" "Unknown flag. For Webpack options, place them after --"
      ;;
    *)
      _fail 2 -v argument "$1" "build takes no positional"
      ;;
  esac
done

if [ -n "$_PREFIX_DIR" ] && [ ! -d "$_PREFIX_DIR" ]; then
  _fail 2 -v prefix "$_PREFIX_DIR" "--prefix is not a folder"
fi

# node runs webpack-cli
_require_cmd node
_export_package_info

# ╭───
# │ Main
# ╰───

_APP_DIR=$(cd -- "${_PREFIX_DIR:-.}" && pwd)
_WEBPACK_CONFIG=$(_pick_config "$_APP_DIR" webpack.config.js)
_POSTCSS_CONFIG=$(_pick_config "$_APP_DIR" postcss.config.js)
_SWC_CONFIG=$(_pick_config "$_APP_DIR" .swcrc)
# A single file has no robots.txt next to it. Webpack drops an --env with an
# empty value, so the config gets no robotsPath
_ROBOTS_FILE=""
if [ -z "$_IS_SINGLE_FILE" ]; then
  _ROBOTS_FILE=$(_pick_file \
    "$_APP_DIR/src/public/robots.txt" "$_VB_DIR/src/public/robots.txt")
fi
_FAVICON_FILE=$(_pick_file \
  "$_APP_DIR/src/public/favicon.svg" "$_VB_DIR/src/public/favicon.svg")

_print_header "$VB_VERSION" "$VB_DESCRIPTION" >&2
_print_summary "$_APP_DIR" "$_WEBPACK_CONFIG" "$_POSTCSS_CONFIG" "$_SWC_CONFIG" \
  "$_ROBOTS_FILE" "$_FAVICON_FILE"

# The default Webpack config reads env.single. An ejected config supports
# --single-file only if it reads env.single too
_run_webpack build "$_WEBPACK_CONFIG" \
  --env "entryDir=$_APP_DIR" \
  --env "postcssConfigPath=$_POSTCSS_CONFIG" \
  --env "swcConfigPath=$_SWC_CONFIG" \
  --env "robotsPath=$_ROBOTS_FILE" \
  --env "faviconPath=$_FAVICON_FILE" \
  --env "logLevel=$_LOG_LEVEL" \
  --mode "$_MODE" ${_IS_SINGLE_FILE:+--env single} "$@"
printf '\n'
_print_build_files "$_APP_DIR"
exit 0
