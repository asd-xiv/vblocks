#!/bin/sh

# NAME
#   vblocks init - Write a template into a folder
#
# SYNOPSIS
#   vblocks init <directory>
#     [--template <plain|xyflow|xyflow-tabs>]
#     [--only <app|plumbing>]
#
# DESCRIPTION
#   A template has two parts: the plumbing, which holds the files of the
#   project folder, and the app, which holds the files of the app folder.
#   After each part, run its post-init hooks in <directory>.
#
#   Print the project folder and each file init adds, updates or drops, then
#   the next steps.
#
# ARGUMENTS
#   directory   The folder to write into, missing or empty
#
# OPTIONS
#   --template <name>   The template, plain, xyflow or xyflow-tabs (default:
#                       plain)
#   --only <part>       Write only the app or only the plumbing (default:
#                       both). With app, init adds the template's
#                       dependencies to the package.json of the project
#                       folder, the parent of <directory>. That package.json
#                       must exist
#   -h, --help          Print this help
#
# ENVIRONMENT
#   NO_COLOR   When non-empty, print without color or the header
#
# EXAMPLE
#   npx @asd14/vblocks init my-app
#   npx @asd14/vblocks init demos --only plumbing
#   npx @asd14/vblocks init demos/flow --template xyflow --only app
#
# EXIT CODES
#   0   Done
#   2   Invalid usage, an unknown template, or a <directory> that is not empty
#       or not a folder
#   3   Could not run: a missing tool, no package.json in the project folder,
#       a folder init could not add, or a failed copy or hook
#
# SEE ALSO
#   vblocks, vblocks serve, node, npm

# vblocks runs this file. Never call it directly.

set -eu

_SCRIPT_DIR=$(dirname "$0")
# shellcheck source=vblocks.sh
. "$_SCRIPT_DIR/vblocks.sh"

# ╭───
# │ Settings
# ╰───

_INIT_DIR=""          # init <directory>
_TEMPLATE="plain"     # init --template
_PARTS="plumbing app" # init --only: "plumbing", "app" or "plumbing app"

# ╭───
# │ Primitives
# ╰───

# _shorten_path <absolute-path>
#
# Print <absolute-path> relative to the current folder when the path is inside
# that folder, otherwise with the home folder as "~".
_shorten_path() {
  case "$1" in
    "$PWD") printf '.\n' ;;
    "$PWD"/*) printf '%s\n' "${1#"$PWD"/}" ;;
    *) _shorten_home "$1" ;;
  esac
}

# _quote_path <path>
#
# Print <path> in single quotes, so a shell reads it back as one word. A
# leading "~/" stays out of the quotes, so the shell still expands it.
_quote_path() {
  # shellcheck disable=SC2088 # a literal "~", for display
  case "$1" in
    "~/"*) qp_home="~/" qp_path=${1#"~/"} ;;
    *) qp_home="" qp_path=$1 ;;
  esac

  # End the quotes, add an escaped quote, open them again: ' becomes '\''
  printf "%s'%s'\n" "$qp_home" "$(printf '%s' "$qp_path" | sed "s/'/'\\\\''/g")"
}

# ╭───
# │ Domain primitives
# ╰───

# _list_templates
#
# Print the template names, one per line. A template is a folder in
# `template/` whose name has no `_` prefix.
_list_templates() {
  for lt_dir in "$_VB_DIR"/template/*/; do
    [ -d "$lt_dir" ] || continue
    lt_name=$(basename "$lt_dir")

    case "$lt_name" in
      _*) ;;
      *) printf '%s\n' "$lt_name" ;;
    esac
  done
}

# _init_project <directory> <template> <parts>
#
# For each of <parts>, copy it from <template> into <directory>, then run its
# hooks there. <parts> is "plumbing", "app" or "plumbing app". A template's file
# replaces the `_common` file of the same path.
#
# EXIT
#   3   A copy or a hook failed
_init_project() {
  ip_dir=$1
  ip_template=$2

  for ip_part in $3; do
    for ip_source in "$_VB_DIR/template/_common" "$_VB_DIR/template/$ip_template"; do
      [ -d "$ip_source/$ip_part" ] || continue

      cp -R -- "$ip_source/$ip_part/." "$ip_dir" \
        || _fail 3 -v file "$ip_source/$ip_part" "Could not copy"
    done

    for ip_source in "$_VB_DIR/template/_common" "$_VB_DIR/template/$ip_template"; do
      ip_hook="$ip_source/post-init-$ip_part.sh"
      [ -f "$ip_hook" ] || continue

      # A hook reads the exported VB_VERSION, and nothing else of this script
      (cd -- "$ip_dir" && sh "$ip_hook") \
        || _fail 3 -v hook "$ip_hook" "The hook failed"
    done
  done
}

# _snapshot_folder <dir>
#
# Print one line per file in <dir>: its checksum and size, a tab, its path
# relative to <dir>. Skip node_modules/, dist/ and .git/. init never writes there. They
# can hold thousands of files.
_snapshot_folder() {
  (cd -- "$1" && find . \( -name node_modules -o -name dist -o -name .git \) \
    -prune -o -type f -print) \
    | sed 's|^\./||' \
    | LC_ALL=C sort \
    | while IFS= read -r sf_file; do
      printf '%s\t%s\n' "$(cksum <"$1/$sf_file")" "$sf_file"
    done
}

# _print_snapshot_diff <before-snapshot> <after-snapshot>
#
# Print "add", "update" or "drop" for each file that differs between two
# snapshots of the project folder, with its path relative to that folder.
_print_snapshot_diff() {
  # Every snapshot line has a tab. The AFTER line has none, so it marks where
  # the second snapshot starts
  {
    printf '%s\n' "$1"
    printf 'AFTER\n'
    printf '%s\n' "$2"
  } | awk -F '\t' \
    -v add="${_GREEN}add${_RESET}" \
    -v update="${_YELLOW}update${_RESET}" \
    -v drop="${_RED}drop${_RESET}" '
    # The color codes take no column, so pad by the plain verb
    function verb(styled, plain) {
      return styled substr("        ", 1, 8 - length(plain))
    }

    NF < 2 { is_after = 1; next }
    !is_after { before[$2] = $1; next }
    {
      seen[$2] = 1
      if (!($2 in before)) printf "%s%s\n", verb(add, "add"), $2
      else if (before[$2] != $1) printf "%s%s\n", verb(update, "update"), $2
    }
    END {
      for (path in before) {
        if (!(path in seen)) printf "%s%s\n", verb(drop, "drop"), path
      }
    }
  '
}

# _name_parts <parts> <template>
#
# Print <parts> as the header names them, eg. "app, xyflow".
_name_parts() {
  case "$1" in
    plumbing) printf 'plumbing\n' ;;
    app) printf 'app, %s\n' "$2" ;;
    *) printf 'plumbing and app, %s\n' "$2" ;;
  esac
}

# _print_init_summary <project-dir>
#
# Print the project folder. The paths that follow are relative to it.
_print_init_summary() {
  printf '%s\t%s\n' "${_BOLD}\$PROJECT_DIR${_RESET}" "$(_shorten_home "$1")"
  printf '\n'
}

# _print_next_steps <parts> <init-dir> <project-dir> <init-abs-dir>
#
# Print the next step and its command, in one line: for the plumbing, the init
# of an app, otherwise the install and the serve of the app. <init-dir> is
# <directory> as init prints it. <project-dir> and <init-abs-dir> are the
# absolute paths of the project folder and of <directory>.
_print_next_steps() {
  case "$1" in
    plumbing)
      _info -v add_cmd "npx @asd14/vblocks init $(_quote_path "$2")/your-app-name --only app" \
        "Next, add an app"
      ;;
    app)
      pns_cd=""
      if [ "$3" != "$PWD" ]; then
        pns_cd="cd $(_quote_path "$(_shorten_path "$3")") && "
      fi
      _info -v serve_cmd "${pns_cd}npm install && npx vblocks serve --prefix $(_quote_path "${4#"$3"/}")" \
        "Next, serve the app"
      ;;
    *)
      _info -v serve_cmd "cd $(_quote_path "$2") && npm install && npx vblocks serve" \
        "Next, serve the app"
      ;;
  esac
}

# ╭───
# │ Flags and positionals
# ╰───

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      _show_help "$0"
      exit 0
      ;;
    --template)
      [ "$#" -lt 2 ] && _fail 2 -v available_templates "$(_list_templates)" "--template needs a name"
      _TEMPLATE=$2
      shift 2
      ;;
    --only)
      [ "$#" -lt 2 ] && _fail 2 -v available_parts "app,plumbing" "--only needs a part"
      case "$2" in
        app | plumbing) _PARTS=$2 ;;
        *) _fail 2 -v part "$2" -v available_parts "app,plumbing" "Unknown part" ;;
      esac
      shift 2
      ;;
    --)
      shift
      if [ "$#" -ne 1 ] || [ -n "$_INIT_DIR" ]; then
        _fail 2 "init takes one folder"
      fi
      _INIT_DIR=$1
      shift
      ;;
    -?*)
      _fail 2 -v flag "$1" "Unknown flag"
      ;;
    *)
      [ -n "$_INIT_DIR" ] && _fail 2 "init takes one folder"
      _INIT_DIR=$1
      shift
      ;;
  esac
done

[ -z "$_INIT_DIR" ] && _fail 2 "init needs a folder"

# One shape for the printed paths: no trailing "/", and no leading "-" that
# a command would read as a flag
while [ "$_INIT_DIR" != "/" ] && [ "${_INIT_DIR%/}" != "$_INIT_DIR" ]; do
  _INIT_DIR=${_INIT_DIR%/}
done
case "$_INIT_DIR" in
  -*) _INIT_DIR="./$_INIT_DIR" ;;
esac

# A template is a folder in template/. A slug rules out a path, eg. `../x`
if ! _is slug "$_TEMPLATE" || [ ! -d "$_VB_DIR/template/$_TEMPLATE" ]; then
  _fail 2 -v template "$_TEMPLATE" -v available_templates "$(_list_templates)" "Unknown template"
fi

# node reads the version. The post-init hooks run npm
_require_cmd node npm
_export_version

# ╭───
# │ Main
# ╰───

if [ -e "$_INIT_DIR" ]; then
  if [ ! -d "$_INIT_DIR" ] || [ -n "$(ls -A -- "$_INIT_DIR")" ]; then
    _fail 2 -v folder "$_INIT_DIR" "The folder exists and is not empty"
  fi
fi
# An app lives in the project folder, its parent. The app hooks write to
# the package.json there
_PROJECT_DIR=""
if [ "$_PARTS" = "app" ]; then
  _PARENT_DIR=$(dirname -- "$_INIT_DIR")
  [ -f "$_PARENT_DIR/package.json" ] \
    || _fail 3 -v folder "$_PARENT_DIR" -v next "npx @asd14/vblocks init <directory> --only plumbing" "No package.json in the parent folder"
  _PROJECT_DIR=$(cd -- "$_PARENT_DIR" && pwd)
fi

mkdir -p -- "$_INIT_DIR" || _fail 3 -v folder "$_INIT_DIR" "Could not add the folder"
_INIT_ABS_DIR=$(cd -- "$_INIT_DIR" && pwd)
_PROJECT_DIR=${_PROJECT_DIR:-$_INIT_ABS_DIR}

_BEFORE_SNAPSHOT=$(_snapshot_folder "$_PROJECT_DIR")
_init_project "$_INIT_DIR" "$_TEMPLATE" "$_PARTS"
_AFTER_SNAPSHOT=$(_snapshot_folder "$_PROJECT_DIR")

_print_header "$VB_VERSION" "${_BOLD}init${_RESET}: $(_name_parts "$_PARTS" "$_TEMPLATE")" >&2
_print_init_summary "$_PROJECT_DIR"
_print_snapshot_diff "$_BEFORE_SNAPSHOT" "$_AFTER_SNAPSHOT"
_print_next_steps "$_PARTS" "$_INIT_DIR" "$_PROJECT_DIR" "$_INIT_ABS_DIR"
exit 0
